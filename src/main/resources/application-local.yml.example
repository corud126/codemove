# 이 파일을 application-local.yml 로 복사한 뒤 실제 값을 입력하세요.
# application-local.yml 은 .gitignore 대상이라 커밋되지 않습니다.
spring:
  datasource:
    # Oracle 11g XE 기본 SID: XE
    url: jdbc:oracle:thin:@<HOST>:1521:XE
    username: <USERNAME>
    password: <PASSWORD>

# 간편 로그인 (Redirect URI: http://localhost:8080/login/oauth/{kakao|naver}/callback)
codemove:
  oauth:
    providers:
      kakao:
        # 카카오 디벨로퍼스 > 앱 키 > REST API 키, 보안 > Client Secret(사용 시)
        client-id: <KAKAO_REST_API_KEY>
        client-secret: <KAKAO_CLIENT_SECRET>
      naver:
        # 네이버 개발자센터 > 애플리케이션 > Client ID / Client Secret
        client-id: <NAVER_CLIENT_ID>
        client-secret: <NAVER_CLIENT_SECRET>
